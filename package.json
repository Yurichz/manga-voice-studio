{
  "name": "manga-voice-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:web": "pnpm build:server && pnpm --filter @mvs/web dev",
    "dev:api": "node --conditions=mvs-source --import tsx apps/api/src/main.ts",
    "dev:worker": "node --conditions=mvs-source --import tsx apps/worker/src/main.ts",
    "bootstrap": "node --conditions=mvs-source --import tsx scripts/bootstrap.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @mvs/web typecheck",
    "lint": "eslint .",
    "test": "pnpm build:server && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm db:generate && pnpm build:server && pnpm --filter @mvs/web build",
    "contract:verify": "tsx scripts/verify-publication-contract.ts",
    "build:server": "tsc -p tsconfig.build.json && node scripts/stage-workspaces.mjs",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint:fix": "eslint . --fix",
    "test:server:integration": "pnpm build:server && node scripts/verify-nest-migration.mjs",
    "test:server:gpu": "pnpm build:server && node scripts/verify-nest-migration.mjs --gpu"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mvs/backend": "workspace:*",
    "@mvs/contracts": "workspace:*",
    "@mvs/database": "workspace:*",
    "@mvs/publication": "workspace:*",
    "@mvs/publication-format": "file:vendor/mvs-publication-format-1.0.0.tgz",
    "@mvs/storage": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "11.2.6",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.1",
    "archiver": "7.0.1",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "ffmpeg-static": "5.3.0",
    "ioredis": "5.8.2",
    "lucide-react": "0.468.0",
    "multer": "2.0.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "tailwind-merge": "3.3.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/archiver": "6.0.3",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "eslint": "9.39.1",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.18"
  },
  "description": "Local AI comic voice editor with NestJS, Next.js and persistent character voices",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yurichz/manga-voice-studio.git"
  },
  "homepage": "https://github.com/Yurichz/manga-voice-studio#readme",
  "bugs": {
    "url": "https://github.com/Yurichz/manga-voice-studio/issues"
  }
}
