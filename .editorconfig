root = true

[*.{ts,tsx,js,mjs,cjs,json}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[{apps/api/src,apps/worker/src,packages/backend/src,packages/storage/src,packages/publication/src,packages/database/src}/**.ts]
indent_style = space
indent_size = 2
end_of_line = lf
max_line_length = 150
